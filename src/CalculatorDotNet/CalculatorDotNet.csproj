<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <NativeShimSourceDir>$(MSBuildProjectDirectory)/../native</NativeShimSourceDir>
    <NativeShimBuildDir>$(MSBuildProjectDirectory)/obj/native/$(Configuration)</NativeShimBuildDir>
    <NativeShimLibraryName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libCalcManagerShim.so</NativeShimLibraryName>
    <NativeShimLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libCalcManagerShim.dylib</NativeShimLibraryName>
    <NativeShimLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">CalcManagerShim.dll</NativeShimLibraryName>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <NativeShimConfigureArgs>-DCMAKE_BUILD_TYPE=Release</NativeShimConfigureArgs>
    <NativeShimOutputPath>$(NativeShimBuildDir)/$(NativeShimLibraryName)</NativeShimOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <NativeShimPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</NativeShimPlatform>
    <NativeShimPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</NativeShimPlatform>
    <NativeShimPlatform Condition="'$(NativeShimPlatform)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">ARM64</NativeShimPlatform>
    <NativeShimPlatform Condition="'$(NativeShimPlatform)' == ''">x64</NativeShimPlatform>
    <NativeShimBuildDir>$(NativeShimBuildDir)/$(NativeShimPlatform)</NativeShimBuildDir>
    <NativeShimConfigureArgs>-A $(NativeShimPlatform)</NativeShimConfigureArgs>
    <NativeShimBuildArgs>--config Release</NativeShimBuildArgs>
    <NativeShimOutputPath>$(NativeShimBuildDir)/Release/$(NativeShimLibraryName)</NativeShimOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../external/calculator/src/Calculator/Resources/en-US/CEngineStrings.resw"
                      LogicalName="CalculatorDotNet.CEngineStrings.en-US.resw" />
  </ItemGroup>

  <Target Name="BuildNativeShim"
          BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems"
          Condition="'$(NativeShimLibraryName)' != ''">
    <Exec Command="cmake -S &quot;$(NativeShimSourceDir)&quot; -B &quot;$(NativeShimBuildDir)&quot; $(NativeShimConfigureArgs)" />
    <Exec Command="cmake --build &quot;$(NativeShimBuildDir)&quot; $(NativeShimBuildArgs) --parallel" />
    <ItemGroup>
      <None Include="$(NativeShimOutputPath)"
            CopyToOutputDirectory="PreserveNewest"
            TargetPath="$(NativeShimLibraryName)"
            Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="BuildAppleShims">
    <Error Condition="!$([MSBuild]::IsOSPlatform('OSX'))"
           Text="Building the Apple shim dylibs requires macOS with Xcode installed." />
    <Exec Command="&quot;$(MSBuildProjectDirectory)/../../build/apple/build-dylibs.sh&quot;" />
  </Target>

  <Import Project="../../build/android/CalcManagerShim.Android.props" />

  <ItemGroup>
    <AndroidShimAbi Include="$(AndroidShimAbis)" />
  </ItemGroup>

  <Target Name="BuildAndroidShim">
    <Error Condition="'$(AndroidNdkDirectory)' == ''"
           Text="No Android NDK found. Set ANDROID_NDK_HOME (or -p:AndroidNdkDirectory=...) to an NDK containing build/cmake/android.toolchain.cmake, or install one with: sdkmanager --install 'ndk;27.3.13750724'" />
    <Error Condition="!Exists('$(AndroidNdkDirectory)/build/cmake/android.toolchain.cmake')"
           Text="'$(AndroidNdkDirectory)' is not a usable NDK: build/cmake/android.toolchain.cmake is missing." />
    <Error Condition="!Exists('$(NativeShimSourceDir)/../../external/calculator/src/CalcManager/UnitConverter.cpp')"
           Text="external/calculator is empty. Run: git submodule update --init" />

    <PropertyGroup>
      <_AndroidNdkCMakePath>$(AndroidNdkDirectory.Replace('\', '/'))</_AndroidNdkCMakePath>
    </PropertyGroup>

    <Message Importance="high" Text="Building CalcManagerShim for Android %(AndroidShimAbi.Identity) (API $(AndroidShimMinApi), NDK $(AndroidNdkDirectory))" />

    <Exec Command="cmake -S &quot;$(NativeShimSourceDir)&quot; -B &quot;$(AndroidShimBuildRoot)/%(AndroidShimAbi.Identity)&quot; -G &quot;Unix Makefiles&quot; -DCMAKE_TOOLCHAIN_FILE=&quot;$(_AndroidNdkCMakePath)/build/cmake/android.toolchain.cmake&quot; -DANDROID_ABI=%(AndroidShimAbi.Identity) -DANDROID_PLATFORM=android-$(AndroidShimMinApi) -DCMAKE_BUILD_TYPE=Release $(AndroidShimMakeProgramArg)" />
    <Exec Command="cmake --build &quot;$(AndroidShimBuildRoot)/%(AndroidShimAbi.Identity)&quot; --parallel" />
  </Target>

  <Import Project="../../build/wasm/CalcManagerShim.Wasm.props" />

  <Target Name="BuildWasmShim">
    <PropertyGroup>
      <_WasmShimArgs>-BuildDir "$(WasmShimBuildDir)" -SdkVersion "$(NETCoreSdkVersion)"</_WasmShimArgs>
      <_WasmShimArgs Condition="'$(WasmShimLegacyExceptions)' == 'true'">$(_WasmShimArgs) -LegacyExceptions</_WasmShimArgs>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../build/wasm/build-wasm-archive.ps1&quot; $(_WasmShimArgs)" />
  </Target>

  <Target Name="_ResolveAndroidMakeProgram" BeforeTargets="BuildAndroidShim"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(AndroidNdkDirectory)' != ''">
    <PropertyGroup>
      <_AndroidNdkMake>$(AndroidNdkDirectory.Replace('\', '/'))/prebuilt/windows-x86_64/bin/make.exe</_AndroidNdkMake>
      <AndroidShimMakeProgramArg Condition="Exists('$(_AndroidNdkMake)')">-DCMAKE_MAKE_PROGRAM=&quot;$(_AndroidNdkMake)&quot;</AndroidShimMakeProgramArg>
    </PropertyGroup>
  </Target>

</Project>
